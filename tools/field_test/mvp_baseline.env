# Daily Town MVP field-test baseline
# Human-approved on 2026-09-07 for the initial Seoul/Jungwon-gu pilot.
# These are non-secret, provisional product-review thresholds.
# Revisit after the first 4 physical sessions and the usability review checklist.
#
# Bash usage:
#   source tools/field_test/mvp_baseline.env
#   gradle installDebug

export FIELD_TEST_MIN_SESSION_SECONDS=600
export FIELD_TEST_MAX_GPS_REJECTION_PERCENT=15
export FIELD_TEST_REQUIRE_MAP_READY=true
export FIELD_TEST_MAX_DISTANCE_ERROR_PERCENT=15
export FIELD_TEST_MAX_BATTERY_DRAIN_PERCENT_PER_HOUR=12
export FIELD_TEST_MIN_ENCOUNTERS_PER_SESSION=2
export FIELD_TEST_MIN_ENCOUNTER_RESOLUTION_PERCENT=50
export FIELD_TEST_MAX_REPEAT_AREA_FATIGUE_PERCENT=40

# Four-session pilot = 2 NEW_AREA + 2 REPEAT_AREA sessions across the two test regions.
export FIELD_TEST_COMPARISON_MIN_SESSIONS_PER_COHORT=2
export FIELD_TEST_COMPARISON_REQUIRE_MATCHING_PRESET=true
export FIELD_TEST_COMPARISON_REQUIRED_EVIDENCE=SESSION_DURATION,SESSION_DISTANCE,GPS_REJECTION_RATE,DISTANCE_ERROR,BATTERY_DRAIN,DISCOVERED_ENCOUNTERS,ENCOUNTER_RESOLUTION,REVISIT_SHARE,REPEAT_AREA_FATIGUE
